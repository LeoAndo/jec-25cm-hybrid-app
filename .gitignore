# ---------------------------------------------------------------------------
# Flutter / Dart（Flutter単元の完成プロジェクト）
# ---------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
**/doc/api/
**/ios/Flutter/.last_build_id
migrate_working_dir/

# 難読化・シンボル
app.*.symbols
app.*.map.json

# Android Studio がビルド成果物を置く場所
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# CocoaPods（iOSビルドで生成される。コミットしない）
**/ios/Pods/
**/ios/.symlinks/
**/macos/Pods/
**/macos/Flutter/ephemeral/
**/ios/Flutter/ephemeral/

# Gradle / ローカルSDK設定
.gradle/
local.properties
*.aab
*.apk
output-metadata.json

# 署名鍵（授業では作らないが、誤ってcommitしないように）
*.jks
*.keystore

# ---------------------------------------------------------------------------
# Monaca（Monaca単元の完成プロジェクト）
# ---------------------------------------------------------------------------
# Monaca CLI / Localkit でローカル開発したときだけできるもの。
# クラウドIDEで作った場合は現れないが、混入を防ぐために無視する。
node_modules/
platforms/
plugins/

# www/components/ の loader.js / loader.css はMonacaの自動生成ファイルだが、
# 配布ZIPを取り込んだ直後から動くようにコミットする（MonacaTemplate と同じ扱い）。

# ---------------------------------------------------------------------------
# エディタ・IDE
# ---------------------------------------------------------------------------
*.iml
*.ipr
*.iws
.idea/
.history
.atom/
.build/
.buildlog/
.svn/
.swiftpm/
# .vscode/ は、授業で配る実行構成を入れる可能性があるので無視しない

# ---------------------------------------------------------------------------
# 教材の配布物（スクリプトの出力）
# ---------------------------------------------------------------------------
dist/

# ---------------------------------------------------------------------------
# Python（scripts/ の検査・配布スクリプト）
# ---------------------------------------------------------------------------
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# OS / ログ
# ---------------------------------------------------------------------------
.DS_Store
*.log
*.class
*.swp

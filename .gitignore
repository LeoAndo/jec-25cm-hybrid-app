# ---------------------------------------------------------------------------
# Flutter / Dart（Flutter単元の完成プロジェクト）
# ---------------------------------------------------------------------------
/F[0-9][0-9]*/.dart_tool/
/F[0-9][0-9]*/.flutter-plugins
/F[0-9][0-9]*/.flutter-plugins-dependencies
/F[0-9][0-9]*/.pub-cache/
/F[0-9][0-9]*/.pub/
/F[0-9][0-9]*/build/
/F[0-9][0-9]*/ios/build/
**/doc/api/
**/ios/Flutter/.last_build_id
/F[0-9][0-9]*/migrate_working_dir/

# 難読化・シンボル
app.*.symbols
app.*.map.json

# Android Studio がビルド成果物を置く場所
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# CocoaPods（iOSビルドで生成される。コミットしない）
**/ios/Pods/
**/ios/.symlinks/
**/macos/Pods/
**/macos/Flutter/ephemeral/
**/ios/Flutter/ephemeral/

# Gradle / ローカルSDK設定
/F[0-9][0-9]*/android/.gradle/
/F[0-9][0-9]*/android/build/
/F[0-9][0-9]*/android/app/build/
/F[0-9][0-9]*/android/local.properties
*.aab
*.apk
output-metadata.json

# 署名鍵（授業では作らないが、誤ってcommitしないように）
*.jks
*.keystore

# ---------------------------------------------------------------------------
# Monaca（Monaca単元の完成プロジェクト）
# ---------------------------------------------------------------------------
# Monaca CLI / Localkit でローカル開発したときだけできるもの。
# クラウドIDEで作った場合は現れないが、混入を防ぐために無視する。
/M[0-9][0-9]*/node_modules/
/M[0-9][0-9]*/platforms/
/M[0-9][0-9]*/plugins/

# www/components/ の loader.js / loader.css はMonacaの自動生成ファイルだが、
# 配布ZIPを取り込んだ直後から動くようにコミットする（MonacaTemplate と同じ扱い）。

# ---------------------------------------------------------------------------
# エディタ・IDE
# ---------------------------------------------------------------------------
*.iml
*.ipr
*.iws
.idea/
.history
.atom/
.build/
.buildlog/
.svn/
.swiftpm/
# .vscode/ は、授業で配る実行構成を入れる可能性があるので無視しない

# ---------------------------------------------------------------------------
# 教材の配布物（スクリプトの出力）
# ---------------------------------------------------------------------------
dist/

# ---------------------------------------------------------------------------
# Python（scripts/ の検査・配布スクリプト）
# ---------------------------------------------------------------------------
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# OS / ログ
# ---------------------------------------------------------------------------
.DS_Store
*.log
*.class
*.swp
